export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

source ~/.local/customizations/colors.zsh
source ~/.local/customizations/shortcuts.zsh

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source ~/.local/customizations/completion.zsh

source ~/.local/customizations/transient.zsh

if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config ~/.local/customizations/tenchi.omp.yaml)"
  preexec_functions+=(transient_pre)
  precmd_functions+=(transient_post)
fi
